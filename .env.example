# App
DEBUG=false
APP_NAME=Toned API

# Database — Neon free tier (recommended) or any Postgres
# 1. Create a project at https://console.neon.tech
# 2. Copy the connection string and swap the scheme to postgresql+psycopg://
#    Neon gives:  postgresql://USER:PASS@HOST/neondb?sslmode=require
#    Use:         postgresql+psycopg://USER:PASS@HOST/neondb?sslmode=require
#
# Local Postgres alternative (Docker optional):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/toned
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

# Supabase auth (JWT secret from Project Settings > API) — optional for seed-only
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_ANON_KEY=your-anon-key
# Legacy service_role key — server only. Needed for hard DELETE /auth/account
# (API Keys → Legacy anon, service_role). Never put this in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS (comma-separated origins, or leave default for local Expo)
# CORS_ORIGINS=["http://localhost:8081","exp://localhost:8081"]

# Optional Expo access token for sending buddy push notifications
# EXPO_ACCESS_TOKEN=

# Optional object storage (Cloudflare R2 / Supabase Storage)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
