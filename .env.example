# App
DEBUG=false
APP_NAME=Toned API

# Database (Supabase Postgres connection string)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Supabase auth (JWT secret from Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_ANON_KEY=your-anon-key

# CORS (comma-separated origins, or leave default for local Expo)
# CORS_ORIGINS=["http://localhost:8081","exp://localhost:8081"]

# Optional object storage (Cloudflare R2 / Supabase Storage)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
